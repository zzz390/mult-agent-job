# === Application ===
APP_ENV=dev
APP_NAME=Job Agent OS
APP_DEBUG=true
APP_VERSION=0.1.0

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_agent_os
DB_POOL_SIZE=10
DB_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# === JWT Authentication ===
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === LLM (DeepSeek / OpenAI Compatible) ===
OPENAI_API_KEY=sk-c1b5899fdbd94e84a5d5be9a7d5d56d4
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_MODEL_FALLBACK=deepseek-v4-flash
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60

# === Embedding (Alibaba DashScope) ===
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024

# === Langfuse (Observability) ===
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# === Harness Runtime ===
HARNESS_MAX_STEPS=50
HARNESS_TOKEN_BUDGET_PER_SESSION=100000
HARNESS_TOOL_TIMEOUT_SECONDS=30
HARNESS_MAX_RETRIES=3
